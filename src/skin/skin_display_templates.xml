<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<skin>
    <windowstyle id="1" type="skinned">
        <color color="#000000" name="Background"/>
        <color color="#ffffff" name="LabelForeground"/>
        <color color="#000000" name="ListboxBackground"/>
        <color color="#ffffff" name="ListboxForeground"/>
        <color color="#000000" name="ListboxSelectedBackground"/>
        <color color="#ffffff" name="ListboxSelectedForeground"/>
        <color color="#000000" name="ListboxMarkedBackground"/>
        <color color="#ffffff" name="ListboxMarkedForeground"/>
        <color color="#000000" name="ListboxMarkedAndSelectedBackground"/>
        <color color="#ffffff" name="ListboxMarkedAndSelectedForeground"/>
        <color color="#ffffff" name="WindowTitleForeground"/>
        <color color="#000000" name="WindowTitleBackground"/>
    </windowstyle>

    <fonts>
        <font filename="nmsbd.ttf" name="FdLcD" scale="100"/>
        <font filename="OpenSans-Regular.ttf" name="FdLcDLight" scale="100"/>
    </fonts>

    <colors>
        <color name="FdLcdTitleForeground" value="#7fffff" /><!-- LightCyan -->
        <color name="FdLcdRed" value="#00f50808" />
        <color name="FdLcdBlack" value="#00000000" />
        <color name="FdLcdAmber" value="#fcc800" />
    </colors>

    <screen name="LCDBackground">
        <ePixmap pixmap="display_bg.png" position="0,0" size="e,e" zPosition="-10" alphatest="on"/>
    </screen>

    <screen name="LCDTitle">
        <widget transparent="1" source="parent.title" render="Label" position="0,0" size="e-3,63" font="FdLcD;55" halign="center" valign="center" zPosition="2" foregroundColor="FdLcdTitleForeground"/>
    </screen>

    <screen name="LCDInfoBarProgramName">
        <widget transparent="1" source="session.Event_Now" render="Label" position="0,10" size="e-3,120" font="FdLcD;50" halign="center" valign="center" zPosition="2">
            <convert type="EventName">Name</convert>
        </widget>
    </screen>

    <screen name="LCDInfoBarProgress">
        <widget source="session.Event_Now" render="Progress" position="0,140" size="e-3,20" borderColor="FdLcdAmber" borderWidth="2" transparent="1" zPosition="2">
            <convert type="EventTime">Progress</convert>
        </widget>
    </screen>

    <screen name="LCDInfoBarMovieProgress">
        <widget source="session.CurrentService" render="Progress" position="0,140" size="e-3,20" borderColor="FdLcdAmber" borderWidth="2" transparent="1" zPosition="2">
            <convert type="ServicePosition">VFDPosition</convert>
        </widget>
    </screen>

    <screen name="LCDInfoBarRemainingTime">
        <widget transparent="1" source="session.Event_Now" render="Label" position="198,e-80" size="197,80" font="FdLcD;60" halign="right" valign="center">
            <convert type="EventTime">Remaining</convert>
            <convert type="RemainingToText">VFDOnlyMinutes</convert>
        </widget>
    </screen>

    <screen name="LCDInfoBarStartEndTime">
        <widget transparent="1" source="session.Event_Now" render="Label" position="0,e-80" size="198,80" font="FdLcD;60" halign="left" valign="center">
            <convert type="EventTime">EndTime</convert>
            <convert type="ClockToText">Format:&gt;%H:%M</convert>
        </widget>
    </screen>

    <screen name="LCDChannelSelectionChannelName">
        <widget transparent="1" source="parent.ServiceEvent" render="RunningText" options="movetype=running,startpoint=0,direction=left,steptime=80,repeat=3,always=0,oneshot=1,startdelay=6000,wrap" position="0,0" size="e-3,130" font="FdLcD;50" halign="center" valign="center" zPosition="2">
            <convert type="ServiceName">Name</convert>
        </widget>
    </screen>

    <screen name="LCDChannelSelectionProgress">
        <widget source="parent.ServiceEvent" render="Progress" position="0,140" size="e-3,20" borderColor="FdLcdAmber" borderWidth="2" transparent="1" zPosition="2">
            <convert type="EventTime">Progress</convert>
        </widget>
    </screen>

    <screen name="LCDChannelSelectionRemainingTime">
        <widget transparent="1" source="parent.ServiceEvent" render="Label" position="0,e-80" size="200,80" font="FdLcD;60" halign="left" valign="center">
            <convert type="EventTime">StartTime</convert>
            <convert type="ClockToText">Format:%H:%M</convert>
        </widget>
        <widget transparent="1" source="parent.ServiceEvent" render="Label" position="200,e-80" size="e-3-200,80" font="FdLcD;60" halign="right" valign="center">
            <convert type="EventTime">Remaining</convert>
            <convert type="RemainingToText">VFDOnlyMinutes</convert>
        </widget>
    </screen>

    <screen name="LCDEPGChannelName">
        <widget transparent="1" source="parent.Service" render="Label" position="0,0" size="e-3,130" font="FdLcD;50" halign="center" valign="center" zPosition="2">
            <convert type="ServiceName">Name</convert>
        </widget>
