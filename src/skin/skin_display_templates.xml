            <convert type="ClockToText">Format:%H:%M</convert>
        </widget>
        <widget transparent="1" source="parent.Event" render="Label" position="198,e-80" size="197,90" font="FdLcD;60" halign="right" valign="center">
            <convert type="EventTime">Remaining</convert>
            <convert type="RemainingToText">VFDOnlyMinutes</convert>
